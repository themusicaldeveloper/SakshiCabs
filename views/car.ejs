<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="inner-page"><header class="site-header"><a class="brand" href="/"><span class="brand-mark">CR</span><span><%= business.name %><small>Comfortable rides, dependable service</small></span></a><a class="back-link" href="/#fleet"><i data-lucide="arrow-left"></i>Back to fleet</a></header>
<main class="car-detail"><div class="detail-image"><img src="<%= car.image_url %>" alt="<%= car.name %>"></div><div class="detail-copy"><span class="eyebrow dark"><%= car.category %></span><h1><%= car.name %></h1><p><%= car.description %></p><div class="detail-specs"><div><i data-lucide="users"></i><strong><%= car.seats %></strong><span>Passengers</span></div><div><i data-lucide="briefcase"></i><strong><%= car.bags %></strong><span>Large bags</span></div><div><i data-lucide="snowflake"></i><strong>AC</strong><span>Comfort</span></div></div><div class="pricing"><span>Starting from</span><strong>₹<%= car.rate_per_km %><small>/km</small></strong><span>or ₹<%= car.day_rate %>/day</span></div><a class="button detail-button" href="/book?car=<%= car.id %>">Request this car <i data-lucide="arrow-right"></i></a><p class="rate-note"><i data-lucide="info"></i>Final fare is confirmed by phone before your ride.</p></div></main>
</body></html>
