<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="ops-page">
  <header class="ops-header">
    <div><span class="ops-logo">CR</span><span><strong><%= currentUser.role === 'driver' ? 'My trips' : 'Dispatch' %></strong><small><%= currentUser.name %></small></span></div>
    <form method="post" action="/admin/logout"><button class="icon-button" title="Sign out"><i data-lucide="log-out"></i></button></form>
  </header>
  <main class="ops-main">
    <% if (notice) { %><div class="ops-notice"><i data-lucide="circle-check"></i><%= notice %></div><% } %>
    <section class="ops-title"><div><p><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'short' }) %></p><h1><%= currentUser.role === 'driver' ? 'Assigned trips' : 'All bookings' %></h1></div><span><%= bookings.length %> trip<%= bookings.length === 1 ? '' : 's' %></span></section>
    <nav class="ops-filters">
      <% ['all','pending','confirmed','completed','cancelled'].forEach((status) => { const count = status === 'all' ? counts.reduce((sum,item) => sum + item.count, 0) : (counts.find((item) => item.status === status)?.count || 0); %>
        <a class="<%= filter === status ? 'active' : '' %>" href="/admin?status=<%= status %>"><%= status === 'all' ? 'All' : status[0].toUpperCase() + status.slice(1) %><span><%= count %></span></a>
      <% }) %>
    </nav>
    <% if (!bookings.length) { %><section class="ops-empty"><i data-lucide="calendar-check"></i><h2>No trips here</h2><p>Assigned bookings will appear in this list.</p></section><% } %>
    <section class="trip-list">
      <% bookings.forEach((booking) => { const pickupDate = new Date(booking.pickup_date); const dateLabel = pickupDate.toLocaleDateString('en-IN', { day:'2-digit', month:'short' }); const timeLabel = String(booking.pickup_time).slice(0,5); %>
        <details class="trip-item" id="booking-<%= booking.id %>">
          <summary>
            <div class="trip-when"><strong><%= timeLabel %></strong><span><%= dateLabel %></span></div>
            <div class="trip-summary"><div><span class="status <%= booking.status %>"><%= booking.status %></span><% if (booking.payment_status === 'paid') { %><span class="paid-dot" title="Paid"><i data-lucide="circle-check"></i></span><% } %></div><strong><%= booking.pickup_location %></strong><span class="trip-to"><i data-lucide="arrow-down"></i><%= booking.drop_location %></span><small><%= booking.driver_name || 'Unassigned' %> · <%= booking.car_name %></small></div>
            <i class="trip-chevron" data-lucide="chevron-down"></i>
          </summary>
          <div class="trip-detail">
            <% if (booking.conflicting_booking_id) { %><div class="admin-schedule-alert"><i data-lucide="calendar-clock"></i><div><strong>Scheduling conflict</strong><span><%= booking.car_name %> already has confirmed booking <%= booking.conflicting_reference %> within the allowed time gap. Call the customer or choose another vehicle below.</span></div></div><% } %>
            <% if (booking.cancellation_status === 'pending') { %><div class="admin-cancel-alert"><i data-lucide="triangle-alert"></i><div><strong>Cancellation requested</strong><span><%= booking.cancellation_reason || 'No reason provided.' %></span></div><form method="post" action="/admin/bookings/<%= booking.id %>/cancellation"><button name="resolution" value="rejected" class="small-action">Keep</button><button name="resolution" value="approved" class="small-action danger">Cancel trip</button></form></div><% } %>
            <div class="customer-line"><div class="avatar"><%= booking.customer_name.charAt(0).toUpperCase() %></div><div><strong><%= booking.customer_name %></strong><span><%= booking.phone %> · <%= booking.reference %></span></div><a class="call-icon" href="tel:<%= booking.phone %>" title="Call customer"><i data-lucide="phone"></i></a></div>
            <dl class="trip-facts"><div><dt>Trip</dt><dd><%= booking.trip_type.replace('-', ' ') %></dd></div><div><dt>Vehicle</dt><dd><%= booking.car_name %><%= booking.registration_number ? ' · ' + booking.registration_number : '' %></dd></div><% if (booking.notes) { %><div class="wide"><dt>Customer note</dt><dd><%= booking.notes %></dd></div><% } %></dl>
            <form class="booking-update-form" method="post" action="/admin/bookings/<%= booking.id %>/update"><input type="hidden" name="return_status" value="<%= filter %>">
              <% if (currentUser.role === 'super_admin') { %><label><span>Vehicle</span><select name="vehicle_id"><% vehicles.forEach((vehicle) => { %><option value="<%= vehicle.id %>" <%= Number(booking.vehicle_id) === Number(vehicle.id) ? 'selected' : '' %>><%= vehicle.name %><%= vehicle.registration_number ? ' - ' + vehicle.registration_number : '' %></option><% }) %></select></label><% } %>
              <% if (currentUser.role === 'super_admin') { %><label><span>Assigned driver</span><select name="driver_id"><option value="">Unassigned</option><% drivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= Number(booking.driver_id) === Number(driver.id) ? 'selected' : '' %>><%= driver.name %></option><% }) %></select></label><% } %>
              <label><span>Trip status</span><select name="status"><% ['pending','confirmed','completed','cancelled'].forEach((status) => { %><option value="<%= status %>" <%= booking.status === status ? 'selected' : '' %>><%= status[0].toUpperCase() + status.slice(1) %></option><% }) %></select></label>
              <% if (currentUser.role === 'super_admin') { %><label><span>Payment</span><select name="payment_status"><option value="unpaid" <%= booking.payment_status === 'unpaid' ? 'selected' : '' %>>Unpaid</option><option value="paid" <%= booking.payment_status === 'paid' ? 'selected' : '' %>>Paid</option></select></label><label class="payment-reference"><span>Payment reference</span><input name="payment_reference" value="<%= booking.payment_reference || '' %>" placeholder="Cash / UPI reference"></label><% } %>
              <button class="button booking-save-button" type="submit"><i data-lucide="save"></i>Save changes</button>
            </form>
          </div>
        </details>
      <% }) %>
    </section>
  </main>
  <nav class="ops-bottom-nav"><a class="active" href="/admin"><i data-lucide="calendar-days"></i><span>Trips</span></a><a href="/admin/notifications"><span class="nav-icon"><i data-lucide="bell"></i><% if (unreadNotificationCount) { %><b><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></b><% } %></span><span>Alerts</span></a><% if (currentUser.role === 'super_admin') { %><a href="/admin/drivers"><i data-lucide="users"></i><span>Drivers</span></a><a href="/admin/vehicles"><i data-lucide="car-front"></i><span>Vehicles</span></a><% } %><a href="/"><i data-lucide="external-link"></i><span>Website</span></a></nav>
</body></html>
