<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="ops-page"><header class="ops-header"><div><span class="ops-logo">CR</span><span><strong>Vehicles</strong><small><%= currentUser.name %></small></span></div><a class="icon-button" href="/admin"><i data-lucide="x"></i></a></header>
<main class="ops-main"><section class="ops-title"><div><p>FLEET</p><h1>Vehicles</h1></div><span><%= vehicles.length %> total</span></section>
<details class="create-panel"><summary><i data-lucide="circle-plus"></i>Add vehicle<i data-lucide="chevron-down"></i></summary><form method="post" action="/admin/vehicles" class="manage-form"><label><span>Vehicle name</span><input name="name" required placeholder="Toyota Innova Crysta"></label><label><span>Registration</span><input name="registration_number" placeholder="MH 01 AB 1234"></label><label><span>Category</span><input name="category" required placeholder="Premium MPV"></label><div class="mini-grid"><label><span>Seats</span><input type="number" name="seats" min="1" required></label><label><span>Bags</span><input type="number" name="bags" min="0" value="2" required></label></div><div class="mini-grid"><label><span>Rate / km</span><input type="number" name="rate_per_km" min="0" required></label><label><span>Day rate</span><input type="number" name="day_rate" min="0" required></label></div><label><span>Image path or URL</span><input name="image_url" value="/images/ertiga.png" required></label><label><span>Description</span><textarea name="description" rows="3"></textarea></label><button class="button" type="submit">Add vehicle</button></form></details>
<section class="manage-list vehicle-manage-list"><% vehicles.forEach((vehicle) => { %><article><img src="<%= vehicle.image_url %>" alt=""><div><strong><%= vehicle.name %></strong><span><%= vehicle.registration_number || 'No registration added' %></span><small><%= vehicle.seats %> seats · ₹<%= Number(vehicle.rate_per_km) %>/km</small></div><form method="post" action="/admin/vehicles/<%= vehicle.id %>/toggle"><button class="state-button <%= vehicle.is_active ? 'on' : '' %>"><%= vehicle.is_active ? 'Listed' : 'Hidden' %></button></form></article><% }) %></section></main>
<nav class="ops-bottom-nav"><a href="/admin"><i data-lucide="calendar-days"></i><span>Trips</span></a><a href="/admin/notifications"><span class="nav-icon"><i data-lucide="bell"></i><% if (unreadNotificationCount) { %><b><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></b><% } %></span><span>Alerts</span></a><a href="/admin/drivers"><i data-lucide="users"></i><span>Drivers</span></a><a class="active" href="/admin/vehicles"><i data-lucide="car-front"></i><span>Vehicles</span></a><a href="/"><i data-lucide="external-link"></i><span>Website</span></a></nav></body></html>
