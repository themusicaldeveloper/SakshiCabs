<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="center-page"><main class="success-card"><div class="success-icon"><i data-lucide="check"></i></div><span class="eyebrow dark">REQUEST RECEIVED</span><h1>Your ride request is with us.</h1><p>We'll call <strong><%= booking.customer_name %></strong> shortly to confirm availability and fare.</p><% if (booking.schedule_conflict_id) { %><div class="manager-review-note"><i data-lucide="phone-call"></i><div><strong>Manager review required</strong><span>Your selected car is already booked near this time. We will call you to discuss another vehicle or confirm if the slot becomes available.</span></div></div><% } %><dl><div><dt>Reference</dt><dd><%= booking.reference %></dd></div><div><dt>Car</dt><dd><%= booking.car_name %></dd></div><div><dt>Pickup</dt><dd><%= new Date(booking.pickup_date).toLocaleDateString("en-IN", { dateStyle: "medium" }) %> at <%= String(booking.pickup_time).slice(0, 5) %></dd></div><div><dt>Journey</dt><dd><%= booking.pickup_location %> to <%= booking.drop_location %></dd></div></dl><a class="button" href="/booking/manage?reference=<%= encodeURIComponent(booking.reference) %>&phone=<%= encodeURIComponent(booking.phone) %>">Track this booking</a><a class="secondary-link" href="/">Back to home</a><a class="phone-link dark-phone" href="tel:<%= business.phone.replace(/\s/g, '') %>"><i data-lucide="phone"></i><%= business.phone %></a></main></body></html>
