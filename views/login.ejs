<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="center-page admin-bg"><main class="login-card"><a class="brand centered" href="/"><span class="brand-mark">CR</span><span><%= business.name %><small>Booking administration</small></span></a><h1>Admin sign in</h1><p>Enter the admin password to manage bookings.</p><form method="post" action="/admin/login"><% if (error) { %><div class="alert"><%= error %></div><% } %><label><span>Password</span><input type="password" name="password" required autofocus></label><button class="button" type="submit">Sign in <i data-lucide="log-in"></i></button></form><a class="back-link" href="/"><i data-lucide="arrow-left"></i>Back to website</a></main></body></html>
