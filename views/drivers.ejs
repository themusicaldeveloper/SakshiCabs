<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="ops-page"><header class="ops-header"><div><span class="ops-logo">CR</span><span><strong>Drivers</strong><small><%= currentUser.name %></small></span></div><a class="icon-button" href="/admin"><i data-lucide="x"></i></a></header>
<main class="ops-main"><section class="ops-title"><div><p>TEAM</p><h1>Drivers</h1></div><span><%= drivers.length %> total</span></section><% if (notice) { %><div class="ops-notice"><%= notice %></div><% } %>
<details class="create-panel"><summary><i data-lucide="user-plus"></i>Add driver<i data-lucide="chevron-down"></i></summary><form method="post" action="/admin/drivers" class="manage-form"><label><span>Driver name</span><input name="name" required></label><label><span>Phone</span><input name="phone" type="tel" required></label><label><span>Login username</span><input name="username" required autocomplete="off"></label><label><span>Temporary password</span><input name="password" type="password" minlength="6" required autocomplete="new-password"></label><button class="button" type="submit">Create driver account</button></form></details>
<section class="manage-list"><% drivers.forEach((driver) => { %><article><div class="avatar"><%= driver.name.charAt(0).toUpperCase() %></div><div><strong><%= driver.name %></strong><span><%= driver.phone %></span><small>@<%= driver.username %> · <%= driver.booking_count %> trips</small></div><form method="post" action="/admin/drivers/<%= driver.id %>/toggle"><button class="state-button <%= driver.is_active ? 'on' : '' %>" title="<%= driver.is_active ? 'Deactivate' : 'Activate' %>"><%= driver.is_active ? 'Active' : 'Inactive' %></button></form></article><% }) %></section></main>
<nav class="ops-bottom-nav"><a href="/admin"><i data-lucide="calendar-days"></i><span>Trips</span></a><a href="/admin/notifications"><span class="nav-icon"><i data-lucide="bell"></i><% if (unreadNotificationCount) { %><b><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></b><% } %></span><span>Alerts</span></a><a class="active" href="/admin/drivers"><i data-lucide="users"></i><span>Drivers</span></a><a href="/admin/vehicles"><i data-lucide="car-front"></i><span>Vehicles</span></a><a href="/"><i data-lucide="external-link"></i><span>Website</span></a></nav></body></html>
