<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="inner-page"><header class="site-header"><a class="brand" href="/"><span class="brand-mark">CR</span><span><%= business.name %><small>Comfortable rides, dependable service</small></span></a><a class="back-link" href="/"><i data-lucide="arrow-left"></i>Home</a></header>
<main class="manage-booking-page"><section class="lookup-panel"><span class="eyebrow dark">YOUR BOOKING</span><h1>Track or manage your ride</h1><p>Use the reference from your confirmation and the same phone number used while booking.</p><form method="get" action="/booking/manage" class="lookup-form"><label><span>Booking reference</span><input name="reference" value="<%= values.reference || '' %>" required placeholder="CR-2026-XXXXXXXX"></label><label><span>Phone number</span><input type="tel" name="phone" value="<%= values.phone || '' %>" required></label><button class="button" type="submit">Find booking <i data-lucide="search"></i></button></form><% if (error) { %><div class="alert"><i data-lucide="circle-alert"></i><%= error %></div><% } %></section>
<% if (booking) { const dateLabel = new Date(booking.pickup_date).toLocaleDateString('en-IN', { dateStyle:'medium' }); %><section class="customer-booking-card"><div class="customer-booking-head"><div><span class="status <%= booking.status %>"><%= booking.status %></span><h2><%= booking.car_name %></h2><small><%= booking.reference %></small></div><i data-lucide="car-front"></i></div><div class="customer-route"><strong><%= booking.pickup_location %></strong><i data-lucide="arrow-down"></i><strong><%= booking.drop_location %></strong></div><dl><div><dt>Pickup</dt><dd><%= dateLabel %> at <%= String(booking.pickup_time).slice(0,5) %></dd></div><div><dt>Driver</dt><dd><%= booking.driver_name || 'To be assigned' %></dd></div><div><dt>Payment</dt><dd><%= booking.payment_status %></dd></div></dl>
<% if (booking.cancellation_status === 'pending') { %><div class="cancellation-state pending"><i data-lucide="clock-3"></i><div><strong>Cancellation requested</strong><span>The vehicle remains reserved until the manager approves your request.</span></div></div><% } else if (booking.cancellation_status === 'rejected') { %><div class="cancellation-state rejected"><i data-lucide="circle-x"></i><div><strong>Cancellation not approved</strong><span>Please contact the manager for assistance.</span></div></div><% } %>
<% if (!['cancelled','completed'].includes(booking.status) && booking.cancellation_status !== 'pending') { %><details class="cancel-request"><summary>Request cancellation <i data-lucide="chevron-down"></i></summary><form method="post" action="/booking/<%= booking.reference %>/cancel-request"><input type="hidden" name="phone" value="<%= booking.phone %>"><label><span>Reason <em>Optional</em></span><textarea name="reason" rows="3" placeholder="Tell us why you need to cancel"></textarea></label><p>This sends a request to the manager. Your booking remains active until approved.</p><button class="danger-button" type="submit">Send cancellation request</button></form></details><% } %>
</section><% } %></main></body></html>
