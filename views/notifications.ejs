<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="ops-page"><header class="ops-header"><div><span class="ops-logo">CR</span><span><strong>Notifications</strong><small><%= currentUser.name %></small></span></div><a class="icon-button" href="/admin"><i data-lucide="x"></i></a></header>
<main class="ops-main"><section class="ops-title"><div><p>INBOX</p><h1>Notifications</h1></div><% if (unreadNotificationCount) { %><form method="post" action="/admin/notifications/read-all"><button class="text-action">Mark all read</button></form><% } %></section>
<% if (!notifications.length) { %><section class="ops-empty"><i data-lucide="bell-off"></i><h2>No notifications</h2><p>New bookings and assigned trips will appear here.</p></section><% } %>
<section class="notification-list"><% notifications.forEach((notification) => { %><article class="notification-item <%= notification.is_read ? '' : 'unread' %>"><div class="notification-icon"><i data-lucide="<%= notification.type === 'new_booking' ? 'calendar-plus' : 'car-front' %>"></i></div><div><div><strong><%= notification.title %></strong><% if (!notification.is_read) { %><i></i><% } %></div><p><%= notification.message %></p><small><%= new Date(notification.created_at).toLocaleString('en-IN', { dateStyle:'medium', timeStyle:'short' }) %></small></div><% if (!notification.is_read) { %><form method="post" action="/admin/notifications/<%= notification.id %>/read"><button class="icon-button" title="Open trip"><i data-lucide="arrow-right"></i></button></form><% } else { %><a class="icon-button" href="/admin" title="Open trips"><i data-lucide="arrow-right"></i></a><% } %></article><% }) %></section></main>
<nav class="ops-bottom-nav"><a href="/admin"><i data-lucide="calendar-days"></i><span>Trips</span></a><a class="active" href="/admin/notifications"><span class="nav-icon"><i data-lucide="bell"></i><% if (unreadNotificationCount) { %><b><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></b><% } %></span><span>Alerts</span></a><% if (currentUser.role === 'super_admin') { %><a href="/admin/drivers"><i data-lucide="users"></i><span>Drivers</span></a><a href="/admin/vehicles"><i data-lucide="car-front"></i><span>Vehicles</span></a><% } %><a href="/"><i data-lucide="external-link"></i><span>Website</span></a></nav></body></html>
