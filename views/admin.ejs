<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | <%= business.name %></title><link rel="stylesheet" href="/styles.css"><script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="admin-page">
  <header class="admin-header"><a class="brand" href="/"><span class="brand-mark">CR</span><span><%= business.name %><small>Booking administration</small></span></a><div><a class="icon-button" href="/" title="Open website"><i data-lucide="external-link"></i></a><form method="post" action="/admin/logout"><button class="icon-button" title="Sign out"><i data-lucide="log-out"></i></button></form></div></header>
  <main class="admin-main">
    <div class="admin-heading"><div><span class="eyebrow dark">OPERATIONS</span><h1>Bookings</h1><p>Review requests, call customers, and record payment.</p></div><div class="today"><i data-lucide="calendar-days"></i><span>Today<strong><%= new Date().toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></strong></span></div></div>
    <nav class="status-tabs"><% ["all", "pending", "confirmed", "completed", "cancelled"].forEach((status) => { const count = status === "all" ? counts.reduce((sum, item) => sum + item.count, 0) : (counts.find((item) => item.status === status)?.count || 0); %><a class="<%= filter === status ? 'active' : '' %>" href="/admin?status=<%= status %>"><%= status[0].toUpperCase() + status.slice(1) %><span><%= count %></span></a><% }) %></nav>
    <% if (!bookings.length) { %><div class="empty-state"><i data-lucide="calendar-x"></i><h2>No <%= filter === "all" ? "" : filter %> bookings</h2><p>New booking requests will appear here.</p></div><% } %>
    <div class="booking-list">
      <% bookings.forEach((booking) => { %><article class="booking-row">
        <div class="booking-date"><strong><%= new Date(booking.pickup_date + "T12:00:00").toLocaleDateString("en-IN", { day: "2-digit" }) %></strong><span><%= new Date(booking.pickup_date + "T12:00:00").toLocaleDateString("en-IN", { month: "short" }) %></span><small><%= booking.pickup_time.slice(0, 5) %></small></div>
        <div class="booking-info"><div class="booking-topline"><span class="status <%= booking.status %>"><%= booking.status %></span><span class="payment <%= booking.payment_status %>"><i data-lucide="<%= booking.payment_status === 'paid' ? 'circle-check' : 'circle-dollar-sign' %>"></i><%= booking.payment_status %></span><small><%= booking.reference %></small></div><h2><%= booking.customer_name %></h2><a href="tel:<%= booking.phone %>"><i data-lucide="phone"></i><%= booking.phone %></a><div class="route"><span><i></i><%= booking.pickup_location %></span><span><i></i><%= booking.drop_location %></span></div><div class="booking-meta"><span><i data-lucide="car-front"></i><%= booking.car_name %></span><span><i data-lucide="repeat-2"></i><%= booking.trip_type.replace("-", " ") %></span><% if (booking.notes) { %><span><i data-lucide="message-square"></i><%= booking.notes %></span><% } %></div></div>
        <div class="booking-actions"><a class="button call-button" href="tel:<%= booking.phone %>"><i data-lucide="phone-call"></i>Call customer</a><form method="post" action="/admin/bookings/<%= booking.id %>/status"><input type="hidden" name="return_status" value="<%= filter %>"><label><span>Booking status</span><select name="status" onchange="this.form.submit()"><% ["pending", "confirmed", "completed", "cancelled"].forEach((status) => { %><option value="<%= status %>" <%= booking.status === status ? "selected" : "" %>><%= status[0].toUpperCase() + status.slice(1) %></option><% }) %></select></label></form><form class="payment-form" method="post" action="/admin/bookings/<%= booking.id %>/payment"><label><span>Payment</span><select name="payment_status"><option value="unpaid" <%= booking.payment_status === "unpaid" ? "selected" : "" %>>Unpaid</option><option value="paid" <%= booking.payment_status === "paid" ? "selected" : "" %>>Paid</option></select></label><label><span>Reference</span><input name="payment_reference" value="<%= booking.payment_reference || "" %>" placeholder="Cash / UPI ref"></label><button class="icon-button save-payment" title="Save payment"><i data-lucide="save"></i></button></form></div>
      </article><% }) %>
    </div>
  </main>
</body></html>
